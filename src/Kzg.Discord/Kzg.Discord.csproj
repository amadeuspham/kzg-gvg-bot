<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetCord" Version="1.0.0-beta.30" />
    <!-- 1.2.1.9, not 1.3.0: libdave 1.3.0 changed signatures NetCord beta.30 still calls, and fails silently.
         DaveCheck refuses to start if the loaded library is 1.3.0 or newer. -->
    <PackageReference Include="libdave" Version="1.2.1.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- For ILogger only: the bot host is ASP.NET Core, which already has it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kzg.Core/Kzg.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kzg.Discord.Tests" />
  </ItemGroup>

</Project>
