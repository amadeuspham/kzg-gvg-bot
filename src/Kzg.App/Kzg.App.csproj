<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The server address the Discord sign-in starts with; players can change it in settings. Empty until the host is chosen. -->
    <KzgDefaultHost></KzgDefaultHost>
    <!-- Where the app looks for updates: a GitHub repository address or a web folder of Velopack files (https). Empty keeps updates off.
         packaging/pack-app.sh passes KZG_UPDATE_FEED here. The environment variable of the same name overrides it at run time. -->
    <KzgUpdateFeed></KzgUpdateFeed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <!-- Keep in step with VELOPACK_VERSION in packaging/pack-app.sh: the vpk that packs must match this library. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon font: a subset of Tabler Icons (MIT), only the glyphs in ViewModels/Icons.cs. The license travels with it. -->
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <AvaloniaResource Include="Assets/icon-256.png" />
    <None Include="Assets/Fonts/TablerIcons.LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kzg.Protocol/Kzg.Protocol.csproj" />
    <ProjectReference Include="../Kzg.Core/Kzg.Core.csproj" />
    <ProjectReference Include="../Kzg.App.Input/Kzg.App.Input.csproj" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KzgDefaultHost</_Parameter1>
      <_Parameter2>$(KzgDefaultHost)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KzgUpdateFeed</_Parameter1>
      <_Parameter2>$(KzgUpdateFeed)</_Parameter2>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="Kzg.App.Tests" />
  </ItemGroup>

</Project>
