<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dave-spike</AssemblyName>
    <RootNamespace>Kzg.Spike.Dave</RootNamespace>
    <!-- A RID puts libdave at the output root, where NetCord's "libdave" import finds it. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NetCord" Version="1.0.0-beta.30" />
    <!-- 1.2.1.9, not 1.3.0: libdave 1.3.0 dropped the recognized-user arguments NetCord beta.30 still passes. -->
    <PackageReference Include="libdave" Version="1.2.1.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- Secrets load through Kzg.Core's own SecretsStore. The built assembly is referenced, not the
         project, so this spike never rebuilds Core's bin/obj under another worker. -->
    <Reference Include="Kzg.Core" HintPath="../../../src/Kzg.Core/bin/Debug/net10.0/Kzg.Core.dll" />
    <Reference Include="Kzg.Protocol" HintPath="../../../src/Kzg.Core/bin/Debug/net10.0/Kzg.Protocol.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- Homebrew's libopus, for encoding the tester clips and decoding the recording. -->
    <None Include="/opt/homebrew/opt/opus/lib/libopus.0.dylib" Link="libopus.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('/opt/homebrew/opt/opus/lib/libopus.0.dylib')" />
  </ItemGroup>
</Project>
